# Server-side only. Never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Required in production. The same value goes into Settings > App password on
# your phone. Anything long and random is fine.
APP_PASSWORD=change-me

# Optional. Which Claude model analyzes meals. Default: claude-sonnet-5
# Cheaper: claude-haiku-4-5   Most accurate: claude-opus-5
# ANALYSIS_MODEL=claude-sonnet-5

# Optional. Analyses allowed per hour per IP address. Default: 40
# ANALYZE_RATE_LIMIT=40
